# Copy to .env. Not needed with --replay.
# Preferred: OpenRouter (Anthropic-compatible endpoint; Claude Code talks to it directly).
OPENROUTER_API_KEY=
# Or Anthropic directly:
ANTHROPIC_API_KEY=
# Optional: model id (OpenRouter default ~anthropic/claude-haiku-latest, Anthropic default claude-haiku-4-5)
AGENTSPACE_EXAMPLE_MODEL=
AGENTSPACE_URL=http://localhost:4800
