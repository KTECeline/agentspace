{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentspace.dev/spec/v0.1/event.schema.json",
  "title": "AgentSpaceEvent",
  "description": "One AgentSpace event (spec v0.1). The `type` field selects the shape of `data`.",
  "oneOf": [
    {
      "$ref": "#/$defs/AgentRegisteredEvent"
    },
    {
      "$ref": "#/$defs/AgentStatusEvent"
    },
    {
      "$ref": "#/$defs/RunStartedEvent"
    },
    {
      "$ref": "#/$defs/RunFinishedEvent"
    },
    {
      "$ref": "#/$defs/RunControlEvent"
    },
    {
      "$ref": "#/$defs/StepStartedEvent"
    },
    {
      "$ref": "#/$defs/StepFinishedEvent"
    },
    {
      "$ref": "#/$defs/LlmCallEvent"
    },
    {
      "$ref": "#/$defs/ToolCallEvent"
    },
    {
      "$ref": "#/$defs/ToolResultEvent"
    },
    {
      "$ref": "#/$defs/MessageEvent"
    },
    {
      "$ref": "#/$defs/HandoffEvent"
    },
    {
      "$ref": "#/$defs/ApprovalRequestedEvent"
    },
    {
      "$ref": "#/$defs/ApprovalResolvedEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    },
    {
      "$ref": "#/$defs/AnomalyDetectedEvent"
    }
  ],
  "$defs": {
    "EventType": {
      "type": "string",
      "enum": [
        "agent.registered",
        "agent.status",
        "run.started",
        "run.finished",
        "run.control",
        "step.started",
        "step.finished",
        "llm.call",
        "tool.call",
        "tool.result",
        "message",
        "handoff",
        "approval.requested",
        "approval.resolved",
        "error",
        "anomaly.detected"
      ]
    },
    "AgentStatus": {
      "type": "string",
      "enum": [
        "idle",
        "thinking",
        "using_tool",
        "waiting",
        "blocked",
        "waiting_human",
        "done",
        "error"
      ]
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "NullableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "Content": {
      "description": "Full prompt/output/argument content. Only present when the SDK runs with capture_content=True, after redaction.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "EventBase": {
      "type": "object",
      "description": "Fields every event carries.",
      "required": [
        "spec_version",
        "id",
        "type",
        "ts",
        "workspace",
        "run_id",
        "agent_id",
        "team_id",
        "parent_id"
      ],
      "properties": {
        "spec_version": {
          "type": "string",
          "const": "0.1"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "Unique event id (used for de-duplication)."
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 timestamp, UTC."
        },
        "workspace": {
          "$ref": "#/$defs/Id"
        },
        "run_id": {
          "$ref": "#/$defs/Id",
          "description": "OTel: trace id / gen_ai.conversation.id."
        },
        "agent_id": {
          "$ref": "#/$defs/NullableId",
          "description": "OTel: gen_ai.agent.id. Null for run-level events with no single agent."
        },
        "team_id": {
          "$ref": "#/$defs/NullableId",
          "description": "Becomes a department zone in the office."
        },
        "parent_id": {
          "$ref": "#/$defs/NullableId",
          "description": "The enclosing step's step_id (OTel: parent span id)."
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "description": "OTel: gen_ai.usage.input_tokens."
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "description": "OTel: gen_ai.usage.output_tokens."
        },
        "tokens_cache_read": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of tokens_in read from the provider's prompt cache. OTel: gen_ai.usage.cache_read.input_tokens."
        },
        "tokens_cache_write": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of tokens_in written to the provider's prompt cache. OTel: gen_ai.usage.cache_creation.input_tokens."
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Cost in USD. Counted in totals on llm.call only."
        },
        "cost_source": {
          "type": "string",
          "enum": [
            "reported",
            "estimated"
          ],
          "description": "Where cost_usd comes from. \"reported\": the framework or provider reported it (the default when cost_usd is set); with no cost_usd it means the cost is reported on another event, so the collector must not estimate one. \"estimated\": the collector priced the tokens from its price table (see DECISIONS D-037)."
        },
        "model": {
          "type": "string",
          "maxLength": 256,
          "description": "OTel: gen_ai.response.model (or gen_ai.request.model)."
        },
        "summary": {
          "type": "string",
          "maxLength": 500,
          "description": "Short, human-readable description. Always safe to display."
        },
        "attributes": {
          "type": "object",
          "description": "Free-form extra metadata (string/number/bool values). OTel attributes land here on OTLP import.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "AgentRegisteredData": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256,
          "description": "OTel: gen_ai.agent.name."
        },
        "team_name": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "OTel: gen_ai.agent.description."
        },
        "framework": {
          "type": "string",
          "maxLength": 64,
          "description": "e.g. langgraph, crewai, manual."
        }
      }
    },
    "AgentStatusData": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "RunStartedData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256,
          "description": "OTel: gen_ai.workflow.name."
        },
        "framework": {
          "type": "string",
          "maxLength": 64
        },
        "input": {
          "$ref": "#/$defs/Content"
        }
      }
    },
    "RunFinishedData": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "cancelled"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "$ref": "#/$defs/Content"
        }
      }
    },
    "RunControlData": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "pause",
            "resume",
            "cancel"
          ]
        },
        "by": {
          "type": "string",
          "maxLength": 256,
          "description": "Who asked (operator name or 'api')."
        }
      }
    },
    "StepStartedData": {
      "type": "object",
      "required": [
        "step_id",
        "name"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id",
          "description": "OTel: span id."
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "chain",
            "custom"
          ],
          "description": "agent ≈ OTel invoke_agent span."
        }
      }
    },
    "StepFinishedData": {
      "type": "object",
      "required": [
        "step_id",
        "name",
        "ok"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "ok": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "LlmCallData": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 64,
          "description": "OTel: gen_ai.provider.name."
        },
        "operation": {
          "type": "string",
          "maxLength": 64,
          "description": "OTel: gen_ai.operation.name (chat, text_completion, ...)."
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "finish_reason": {
          "type": "string",
          "maxLength": 64,
          "description": "OTel: gen_ai.response.finish_reasons[0]."
        },
        "input": {
          "$ref": "#/$defs/Content",
          "description": "OTel: gen_ai.input.messages."
        },
        "output": {
          "$ref": "#/$defs/Content",
          "description": "OTel: gen_ai.output.messages."
        }
      }
    },
    "ToolCallData": {
      "type": "object",
      "required": [
        "tool_name",
        "call_id"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "maxLength": 256,
          "description": "OTel: gen_ai.tool.name."
        },
        "call_id": {
          "$ref": "#/$defs/Id",
          "description": "OTel: gen_ai.tool.call.id."
        },
        "arguments": {
          "$ref": "#/$defs/Content",
          "description": "OTel: gen_ai.tool.call.arguments."
        },
        "arguments_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "Keyed hash (HMAC-SHA256, first 16 hex chars) of the canonical JSON of the call's arguments. The key is random per process, so equal hashes mean equal arguments within one process (one run) and nothing can be recovered from it. Sent even when content capture is off; used to detect repeated identical calls (DECISIONS D-044)."
        }
      }
    },
    "ToolResultData": {
      "type": "object",
      "required": [
        "tool_name",
        "call_id",
        "ok"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "maxLength": 256
        },
        "call_id": {
          "$ref": "#/$defs/Id"
        },
        "ok": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        },
        "result": {
          "$ref": "#/$defs/Content",
          "description": "OTel: gen_ai.tool.call.result."
        }
      }
    },
    "MessageData": {
      "type": "object",
      "properties": {
        "from_agent_id": {
          "$ref": "#/$defs/NullableId"
        },
        "to_agent_id": {
          "$ref": "#/$defs/NullableId"
        },
        "role": {
          "type": "string",
          "maxLength": 32
        },
        "text": {
          "$ref": "#/$defs/Content"
        }
      }
    },
    "HandoffData": {
      "type": "object",
      "required": [
        "from_agent_id",
        "to_agent_id"
      ],
      "properties": {
        "from_agent_id": {
          "$ref": "#/$defs/Id"
        },
        "to_agent_id": {
          "$ref": "#/$defs/Id"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "ApprovalRequestedData": {
      "type": "object",
      "required": [
        "approval_id",
        "reason"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/Id"
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "payload": {
          "$ref": "#/$defs/Content"
        },
        "timeout_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ApprovalResolvedData": {
      "type": "object",
      "required": [
        "approval_id",
        "decision"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/Id"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "timeout"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 2000
        },
        "resolved_by": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "ErrorData": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "maxLength": 256,
          "description": "Exception class name (OTel: error.type)."
        },
        "stack": {
          "type": "string",
          "maxLength": 16000
        }
      }
    },
    "AgentRegisteredEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "agent.registered"
        },
        "data": {
          "$ref": "#/$defs/AgentRegisteredData"
        }
      }
    },
    "AgentStatusEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "agent.status"
        },
        "data": {
          "$ref": "#/$defs/AgentStatusData"
        }
      }
    },
    "RunStartedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "run.started"
        },
        "data": {
          "$ref": "#/$defs/RunStartedData"
        }
      }
    },
    "RunFinishedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "run.finished"
        },
        "data": {
          "$ref": "#/$defs/RunFinishedData"
        }
      }
    },
    "RunControlEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "run.control"
        },
        "data": {
          "$ref": "#/$defs/RunControlData"
        }
      }
    },
    "StepStartedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "step.started"
        },
        "data": {
          "$ref": "#/$defs/StepStartedData"
        }
      }
    },
    "StepFinishedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "step.finished"
        },
        "data": {
          "$ref": "#/$defs/StepFinishedData"
        }
      }
    },
    "LlmCallEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "llm.call"
        },
        "data": {
          "$ref": "#/$defs/LlmCallData"
        }
      }
    },
    "ToolCallEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "tool.call"
        },
        "data": {
          "$ref": "#/$defs/ToolCallData"
        }
      }
    },
    "ToolResultEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "tool.result"
        },
        "data": {
          "$ref": "#/$defs/ToolResultData"
        }
      }
    },
    "MessageEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "message"
        },
        "data": {
          "$ref": "#/$defs/MessageData"
        }
      }
    },
    "HandoffEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "handoff"
        },
        "data": {
          "$ref": "#/$defs/HandoffData"
        }
      }
    },
    "ApprovalRequestedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "approval.requested"
        },
        "data": {
          "$ref": "#/$defs/ApprovalRequestedData"
        }
      }
    },
    "ApprovalResolvedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "approval.resolved"
        },
        "data": {
          "$ref": "#/$defs/ApprovalResolvedData"
        }
      }
    },
    "ErrorEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "data": {
          "$ref": "#/$defs/ErrorData"
        }
      }
    },
    "AnomalyDetectedData": {
      "type": "object",
      "description": "A finding from one of the collector's detectors. Only the collector emits this event; ingest rejects it from clients (DECISIONS D-044).",
      "required": [
        "detector",
        "severity",
        "message"
      ],
      "properties": {
        "detector": {
          "type": "string",
          "maxLength": 64,
          "description": "Which detector fired (repeated_tool_call, failure_loop, handoff_loop, tool_call_outlier, usage_outlier, ...)."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "Short, human-readable, safe to display (tool and agent names, numbers; never content)."
        },
        "evidence": {
          "type": "object",
          "description": "The numbers behind the finding, e.g. {\"count\": 4, \"baseline_p50\": 1, \"baseline_runs\": 12}.",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "subject_ids": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Id"
          },
          "description": "Ids of the events that triggered it."
        }
      }
    },
    "AnomalyDetectedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventBase"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "anomaly.detected"
        },
        "data": {
          "$ref": "#/$defs/AnomalyDetectedData"
        }
      }
    },
    "IngestBatch": {
      "type": "object",
      "description": "Body of POST /v1/events.",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#"
          }
        }
      }
    }
  }
}
